# Secrets must come from your vault / secret manager (plan §5) — never hardcode.
# Copy to .env (gitignored) and fill in the providers you have.

# DeepL (Tier 1)
DEEPL_API_KEY=

# AWS Translate (Tier 2)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# Google Gemini (Tier 3)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Infrastructure
DATABASE_URL=postgresql+psycopg2://edunexa:edunexa@localhost:55432/mail_translation
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=2592000
WORKER_POOL_SIZE=10
ENGINE_TIMEOUT_SECONDS=3.0
